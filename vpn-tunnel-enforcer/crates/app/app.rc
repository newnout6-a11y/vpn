// Compiled by embed-resource (build.rs) with rc.exe from the Windows SDK.
// VERSION_* / FILE_VERSION_STR are passed as macros from build.rs (CARGO_PKG_VERSION).
#include <winres.h>

// 32512 == IDI_APPLICATION. Explorer uses the first icon group as the exe icon, and
// dioxus-desktop's default_icon() / tray default look exactly this ordinal up.
32512 ICON "../ui/assets/icon.ico"

// RT_MANIFEST (24), id 1 == CREATEPROCESS_MANIFEST_RESOURCE_ID
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION  VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "VPN Tunnel Enforcer"
            VALUE "FileDescription",  "VPN Tunnel Enforcer"
            VALUE "FileVersion",      FILE_VERSION_STR
            VALUE "InternalName",     "vpn-tunnel-enforcer"
            VALUE "OriginalFilename", "VPN Tunnel Enforcer.exe"
            VALUE "ProductName",      "VPN Tunnel Enforcer"
            VALUE "ProductVersion",   FILE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
